# ==========================================
# National Digital Identity System - Environment Configuration
# ==========================================

# Node.js Backend Port (Default: 3000)
PORT=3000

# Environment Mode (production / development)
NODE_ENV=production

# Python Blockchain Service URL
# For local VPS: http://127.0.0.1:5001
# For Docker Compose: http://python-service:5001
PYTHON_SERVICE_URL=http://127.0.0.1:5001

# Cryptographic Secret for Signing Citizen JWT Session Tokens
# Generate a strong 64+ char random string in production
JWT_SECRET=super_secret_national_blockchain_key_2026_change_in_production

# Python Microservice Configuration
HOST=0.0.0.0
PYTHON_PORT=5001
